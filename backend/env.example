# =============================================================================
# ATTIERLY - AI-POWERED FASHION ASSISTANT
# Environment Configuration
# =============================================================================

# =============================================================================
# LLM CONFIGURATION (REQUIRED - Choose ONE provider)
# =============================================================================

# Primary LLM Provider (Required)
LLM_PROVIDER=openai
LLM_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-3.5-turbo
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1000

# Alternative LLM Providers (Uncomment and configure ONE):
# LLM_PROVIDER=anthropic
# LLM_API_KEY=your_anthropic_api_key_here
# LLM_MODEL=claude-3-sonnet-20240229

# LLM_PROVIDER=google
# LLM_API_KEY=your_google_api_key_here
# LLM_MODEL=gemini-1.5-flash

# =============================================================================
# EXTERNAL API KEYS (OPTIONAL - Fallbacks available)
# =============================================================================

# Weather Service
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Location/Geocoding Service
OPENCAGE_API_KEY=your_opencage_api_key_here

# =============================================================================
# E-COMMERCE CONFIGURATION (OPTIONAL - Web scraping is primary)
# =============================================================================

# SERPAPI for Google Shopping (Fallback to web scraping)
SERPAPI_KEY=your_serpapi_key_here

# Note: Amazon and eBay APIs are disabled - using web scraping instead

# =============================================================================
# SERVICE CONFIGURATION
# =============================================================================

# Inter-service Communication URLs
USER_SERVICE_URL=http://localhost:8002
ECOMMERCE_SERVICE_URL=http://localhost:8003

# =============================================================================
# LOGGING & DEBUGGING
# =============================================================================

LOG_LEVEL=INFO
